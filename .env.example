# Environment Variables Template for SupplyTwinAI
# Copy to .env for local development. Never commit .env to source control.

# Environment Mode
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL Configuration
POSTGRES_USER=supplytwin
POSTGRES_PASSWORD=supplytwin_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=supplytwin_db
DATABASE_URL=postgresql+asyncpg://supplytwin:supplytwin_pass@localhost:5432/supplytwin_db

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=supplytwin_pass

# AI & LLM Configuration (Google Gemini via LangChain/LangGraph)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_ID=gemini-2.5-flash

# JWT & Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production_32bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# External APIs
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
NEWS_API_KEY=your_news_api_key_here

# Agent & Risk Configuration
RISK_THRESHOLD_ALERT=60.0
SHIPMENT_DELAY_THRESHOLD_HOURS=24
